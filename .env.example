# AutoNorth production security settings
# Never commit real secrets. Put these values in your hosting provider's secret/environment settings.

JWT_SECRET=replace-with-a-long-random-secret
IPQS_API_KEY=replace-with-your-ipqualityscore-api-key
BLOCK_ANONYMOUS_NETWORKS=true
SECURITY_FAIL_OPEN=false
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=120
